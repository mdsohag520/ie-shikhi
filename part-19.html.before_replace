<footer>
  <div class="wrap">IE শিখি · Part 19: Process, Capacity, Utilization ও Efficiency</div>
</footer>

<script>
  const nf = (n, d) => Number(n).toLocaleString('en-US', {minimumFractionDigits: d === undefined ? 2 : d, maximumFractionDigits: d === undefined ? 2 : d});
  const val = id => parseFloat(document.getElementById(id).value);

  function fail(errId, outId, msg){
    const e = document.getElementById(errId);
    e.textContent = msg; e.style.display = 'block';
    document.getElementById(outId).style.display = 'none';
  }
  function reset(errId, outId){
    document.getElementById(errId).style.display = 'none';
    document.getElementById(outId).style.display = 'none';
  }

  // Calc 1
  document.getElementById('go1').addEventListener('click', function(){
    reset('err1','out1');
    const o = val('ops1'), m = val('min1'), e = val('eff1'), s = val('smv1');
    if ([o,m,s].some(n => isNaN(n) || n <= 0)) { fail('err1','out1','সব ঘরে সঠিক সংখ্যা লিখুন।'); return; }
    if (isNaN(e) || e <= 0 || e > 100) { fail('err1','out1','Efficiency ১-১০০ এর মধ্যে লিখুন।'); return; }
    const cap = (o * m * (e/100)) / s;
    document.getElementById('sum1').innerHTML =
      '<b>Man Capacity = ' + nf(cap, 0) + ' Pcs/দিন</b><br>' +
      'Formula: (' + o + ' × ' + m + ' × ' + (e/100).toFixed(2) + ') ÷ ' + s + '<br>' +
      'মানে ' + o + ' জন Operator দিয়ে ' + e + '% Efficiency তে দিনে ' + nf(cap, 0) + ' Bag হবে।';
    document.getElementById('out1').style.display = 'block';
  });

  // Calc 2
  document.getElementById('go2').addEventListener('click', function(){
    reset('err2','out2');
    const a = val('avail2'), i = val('idle2');
    if (isNaN(a) || a <= 0 || isNaN(i) || i < 0 || i > a) { fail('err2','out2','Available Minutes সঠিক ও Idle ≤ Available দিন।'); return; }
    const u = (a - i) / a * 100;
    document.getElementById('sum2').innerHTML =
      '<b>Man Utilization = ' + nf(u, 1) + '%</b><br>' +
      'Formula: (' + a + ' − ' + i + ') ÷ ' + a + ' × 100<br>' +
      'Idle = ' + nf(i, 0) + ' মিনিট (' + nf(i/a*100, 1) + '%)। ' +
      (u < 80 ? '⚠️ ৮০% এর নিচে, Idle কমানোর সুযোগ আছে।' : '✅ ভালো অবস্থা।');
    document.getElementById('out2').style.display = 'block';
  });

  // Calc 3
  document.getElementById('go3').addEventListener('click', function(){
    reset('err3','out3');
    const p = val('planned3'), d = val('down3');
    if (isNaN(p) || p <= 0 || isNaN(d) || d < 0 || d > p) { fail('err3','out3','Planned Time সঠিক ও Downtime ≤ Planned দিন।'); return; }
    const u = (p - d) / p * 100;
    document.getElementById('sum3').innerHTML =
      '<b>Machine Utilization = ' + nf(u, 1) + '%</b><br>' +
      'Formula: (' + p + ' − ' + d + ') ÷ ' + p + ' × 100<br>' +
      'Downtime = ' + d + ' মিনিট (' + nf(d/p*100, 1) + '%)। ' +
      (u < 85 ? '⚠️ ৮৫% এর নিচে, Breakdown বা Setup কমানোর সুযোগ আছে।' : '✅ ভালো অবস্থা।');
    document.getElementById('out3').style.display = 'block';
  });

  // Calc 4
  document.getElementById('go4').addEventListener('click', function(){
    reset('err4','out4');
    const o = val('out4'), s = val('smv4'), op = val('ops4'), m = val('min4');
    if ([o,s,op,m].some(n => isNaN(n) || n <= 0)) { fail('err4','out4','সব ঘরে সঠিক সংখ্যা লিখুন।'); return; }
    const earned = o * s;
    const avail = op * m;
    const eff = earned / avail * 100;
    document.getElementById('sum4').innerHTML =
      '<b>Efficiency = ' + nf(eff, 2) + '%</b><br>' +
      'Earned Minutes = ' + o + ' × ' + s + ' = ' + nf(earned, 0) + '<br>' +
      'Available Minutes = ' + op + ' × ' + m + ' = ' + nf(avail, 0) + '<br>' +
      'Efficiency = ' + nf(earned, 0) + ' ÷ ' + nf(avail, 0) + ' × 100 = ' + nf(eff, 2) + '%';
    document.getElementById('out4').style.display = 'block';
  });

  // Calc 5
  document.getElementById('go5').addEventListener('click', function(){
    reset('err5','out5');
    const o = val('out5'), s = val('smv5'), p = val('planned5'), d = val('down5');
    if ([o,s,p].some(n => isNaN(n) || n <= 0) || isNaN(d) || d < 0 || d > p) { fail('err5','out5','সব ঘরে সঠিক সংখ্যা লিখুন (Downtime ≤ Planned)।'); return; }
    const u = (p - d) / p * 100;
    const e = (o * s) / p * 100;
    document.getElementById('sum5').innerHTML =
      '<b>Machine Utilization = ' + nf(u, 1) + '%</b><br>' +
      '<b>Machine Efficiency = ' + nf(e, 1) + '%</b><br>' +
      'Utilization = (' + p + ' − ' + d + ') ÷ ' + p + ' × 100<br>' +
      'Efficiency = (' + o + ' × ' + s + ') ÷ ' + p + ' × 100<br>' +
      (u > e ? '⚠️ Utilization বেশি, কিন্তু Efficiency কম — Slow Speed বা ছোট বিরতি আছে।' : '✅ Efficiency Utilization এর কাছাকাছি।');
    document.getElementById('out5').style.display = 'block';
  });

  // Quiz
  const quiz = [
    {q:"Capacity মানে কী?",
     o:["Actual Output","Maximum সম্ভাব্য Output","Idle Time"],
     a:1, w:"Capacity = নির্দিষ্ট সময়ে সর্বোচ্চ Output। Actual Output Capacity এর কম বা সমান।"},
    {q:"Man Capacity এর সঠিক Formula কোনটি?",
     o:["(Operator × কাজের মিনিট × Efficiency) ÷ SMV","Output ÷ Input","(Output × SMV) ÷ Minutes"],
     a:0, w:"Man Capacity = (Operator × কাজের মিনিট × Efficiency) ÷ SMV।"},
    {q:"Machine Utilization 90% মানে কী?",
     o:["Machine ১০% সময় বন্ধ ছিল","Machine ৯০% Efficiency তে চলেছে","Machine ৯০% দাম পেয়েছে"],
     a:0, w:"Machine Utilization 90% মানে ৯০% সময় চলেছে, ১০% সময় Downtime (Breakdown, Setup, Idle) ছিল।"},
    {q:"Efficiency এর সঠিক Formula কোনটি?",
     o:["(Output × SMV) ÷ (Operator × কাজের মিনিট) × 100","Actual ÷ Capacity × 100","SMV ÷ Cycle Time"],
     a:0, w:"Efficiency = (Output × SMV) ÷ (Operator × কাজের মিনিট) × 100।"},
    {q:"Utilization ও Efficiency এর মূল পার্থক্য কী?",
     o:["Utilization সময়ের ব্যবহার, Efficiency কাজের গুণ ও গতি","দুটো একই","Efficiency সময়ের ব্যবহার"],
     a:0, w:"Utilization = কতটা সময় কাজে লেগেছে। Efficiency = কতটা ভালো কাজ হয়েছে (SMV এর তুলনায়)।"},
    {q:"Line Capacity 720, Actual Output 504 হলে Capacity Utilization কত?",
     o:["60%","70%","80%"],
     a:1, w:"Capacity Utilization = 504 ÷ 720 × 100 = 70%।"},
    {q:"SMV 0.90, Output 400, Planned Time 480 হলে Machine Efficiency কত?",
     o:["75%","83%","90%"],
     a:0, w:"Efficiency = (400 × 0.90) ÷ 480 × 100 = 360 ÷ 480 × 100 = 75%।"},
    {q:"Idle Time কমলে সাধারণত কোনটা বাড়ে?",
     o:["Machine Breakdown","Utilization ও Efficiency","Defect"],
     a:1, w:"Idle Time কমলে সময় কাজে লাগে, তাই Utilization ও Efficiency দুটোই বাড়ে।"},
    {q:"Process এর ৪টি উপাদান কী কী?",
     o:["Man, Machine, Material, Method","Man, Money, Market, Method","Plan, Do, Check, Act"],
     a:0, w:"Process এর ৪টি M = Man, Machine, Material, Method।"},
    {q:"শুধু Utilization বেশি কিন্তু Efficiency কম হলে কী বোঝায়?",
     o:["Machine সব সময় চলছে কিন্তু Slow Speed বা ছোট বিরতি আছে","Machine বন্ধ","Output বেশি"],
     a:0, w:"Utilization বেশি = সময় কাজে লেগেছে। Efficiency কম = কাজের গতি Standard এর নিচে। মানে Slow Speed বা ছোট ছোট বিরতি।"}
  ];

  const box = document.getElementById('quiz');
  const scoreEl = document.getElementById('score');
  let answered = 0, correct = 0;

  quiz.forEach((item, i) => {
    const d = document.createElement('div');
    d.className = 'q';
    d.innerHTML = '<p class="qt">' + (i+1) + '. ' + item.q + '</p>';
    const why = document.createElement('p');
    why.className = 'why';
    const btns = item.o.map((txt, j) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = txt;
      b.addEventListener('click', () => {
        if (d.dataset.done) return;
        d.dataset.done = '1';
        answered++;
        if (j === item.a) { b.classList.add('right'); correct++; why.textContent = '✅ সঠিক! ' + item.w; }
        else { b.classList.add('wrong'); btns[item.a].classList.add('right'); why.textContent = '⚠️ ভুল। ' + item.w; }
        why.style.display = 'block';
        if (answered === quiz.length) {
          scoreEl.textContent = 'তোমার স্কোর: ' + correct + ' / ' + quiz.length + (correct === quiz.length ? ' 🎉 দারুণ!' : ' — আবার পড়ে চেষ্টা করো।');
        }
      });
      d.appendChild(b);
      return b;
    });
    d.appendChild(why);
    box.appendChild(d);
  });
</script>
