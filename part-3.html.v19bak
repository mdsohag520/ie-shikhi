<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Part 3: Time Study ও Work Measurement — IE শিখি</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anek+Bangla:wght@500;700;800&family=Hind+Siliguri:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#F3F5F7;--ink:#14213D;--ink-soft:#4A5670;--oxblood:#7A1F2B;--thread:#E9B824;
    --line:#D5DAE2;--white:#FFFFFF;--green:#2E7D5B;
    --head:'Anek Bangla','Hind Siliguri','Noto Sans Bengali',sans-serif;
    --body:'Hind Siliguri','Noto Sans Bengali',system-ui,sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{font-family:var(--body);background:var(--paper);color:var(--ink);font-size:17px;line-height:1.75}
  a{color:inherit}
  :focus-visible{outline:3px solid var(--oxblood);outline-offset:3px;border-radius:4px}
  .wrap{max-width:720px;margin:0 auto;padding:0 18px}

  header.top{position:sticky;top:0;z-index:10;background:var(--ink);color:var(--white)}
  header.top .wrap{display:flex;align-items:center;justify-content:space-between;padding-top:12px;padding-bottom:12px}
  .logo{font-family:var(--head);font-weight:800;font-size:20px;text-decoration:none}
  .logo span{color:var(--thread)}
  .back{font-size:14px;color:#C9D3EA;text-decoration:none}
  .back:hover{text-decoration:underline}

  .title{padding:30px 0 10px}
  .title .crumb{font-size:14px;color:var(--ink-soft)}
  .title h1{font-family:var(--head);font-weight:800;font-size:clamp(28px,7vw,40px);line-height:1.3;margin:4px 0 8px}
  .title p{color:var(--ink-soft)}

  nav.toc{background:var(--white);border:1px solid var(--line);border-radius:10px;padding:14px 18px;margin:16px 0 8px}
  nav.toc strong{font-family:var(--head);display:block;margin-bottom:4px}
  nav.toc ol{padding-left:22px;font-size:16px}
  nav.toc a{text-decoration:none;color:var(--oxblood)}
  nav.toc a:hover{text-decoration:underline}

  section.topic{padding:26px 0 8px;border-top:1px solid var(--line);margin-top:20px}
  section.topic h2{font-family:var(--head);font-size:25px;line-height:1.4;margin-bottom:10px}
  section.topic h3{font-family:var(--head);font-size:18px;margin:18px 0 4px;color:var(--oxblood)}
  p{margin-bottom:10px}
  ul.plain,ol.plain{padding-left:22px;margin-bottom:10px}
  ul.plain li,ol.plain li{margin-bottom:4px}
  b.term{font-weight:600}

  .note{border-left:5px solid var(--thread);background:var(--white);padding:10px 14px;border-radius:0 8px 8px 0;margin:14px 0;font-size:16px}
  .note.warn{border-left-color:var(--oxblood)}
  .note.ok{border-left-color:var(--green)}
  .example{background:var(--ink);color:var(--white);border-radius:10px;padding:14px 18px;margin:14px 0}
  .example strong{color:var(--thread);font-family:var(--head)}
  .formula{background:var(--white);border:2px solid var(--ink);border-radius:10px;padding:12px 16px;margin:12px 0;font-family:var(--head);font-size:18px;line-height:1.8}
  .formula small{display:block;font-family:var(--body);font-size:14px;color:var(--ink-soft)}

  table{width:100%;border-collapse:collapse;margin:12px 0;font-size:15px;background:var(--white)}
  th,td{border:1px solid var(--line);padding:8px 10px;text-align:left;vertical-align:top}
  th{background:#E6EAF0;font-family:var(--head)}
  .scroll{overflow-x:auto}

  .steps{list-style:none;margin:12px 0;padding-left:0;border-left:3px dashed var(--thread);margin-left:8px}
  .steps li{position:relative;padding:0 0 12px 20px}
  .steps li::before{content:"";position:absolute;left:-9px;top:9px;width:15px;height:15px;border-radius:50%;background:var(--oxblood);border:3px solid var(--paper)}

  /* Calculator */
  .calc{background:var(--white);border:1px solid var(--line);border-radius:10px;padding:16px;margin:14px 0}
  .calc label{display:block;font-weight:600;font-size:15px;margin:10px 0 4px}
  .calc textarea,.calc input{width:100%;font:inherit;font-size:16px;border:1px solid var(--line);border-radius:8px;padding:9px 12px;background:var(--paper);color:var(--ink)}
  .calc .row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .calc button{margin-top:14px;font:inherit;font-weight:600;background:var(--oxblood);color:var(--white);border:0;border-radius:10px;padding:11px 22px;cursor:pointer}
  .calc button:hover{background:#5E1721}
  .calc .out{margin-top:14px;display:none}
  .calc .out table{margin:0}
  .calc .err{color:var(--oxblood);font-weight:600;margin-top:10px;display:none}

  .q{background:var(--white);border:1px solid var(--line);border-radius:10px;padding:14px 16px;margin:12px 0}
  .q p.qt{font-weight:600;margin-bottom:8px}
  .q button{display:block;width:100%;text-align:left;font:inherit;font-size:16px;background:var(--paper);border:1px solid var(--line);border-radius:8px;padding:9px 12px;margin-bottom:6px;cursor:pointer;color:var(--ink)}
  .q button:hover{border-color:var(--ink)}
  .q button.right{background:#DDF1E8;border-color:var(--green)}
  .q button.wrong{background:#F6DADD;border-color:var(--oxblood)}
  .q .why{display:none;font-size:15px;color:var(--ink-soft);margin-top:6px}
  .score{font-family:var(--head);font-size:20px;margin-top:10px}

  .pager{display:flex;justify-content:space-between;gap:10px;padding:26px 0 40px;border-top:1px solid var(--line);margin-top:26px;flex-wrap:wrap}
  .pager a{display:inline-block;text-decoration:none;font-weight:600;padding:11px 18px;border-radius:10px}
  .pager .prev{border:1px solid var(--ink)}
  .pager .next{background:var(--oxblood);color:var(--white)}
  footer{background:var(--ink);color:#B8C3DC;padding:20px 0;font-size:14px}
  @media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
<body>

<header class="top">
  <div class="wrap">
    <a class="logo" href="index.html">IE <span>শিখি</span></a>
    <a class="back" href="index.html#parts">← সব Part</a>
  </div>
</header>

<main>
<div class="wrap">

  <div class="title">
    <div class="crumb">Part 3 / 18</div>
    <h1>Time Study ও Work Measurement</h1>
    <p>একটা কাজে কত সময় লাগা উচিত, তা ন্যায্যভাবে মাপার পদ্ধতি। এখান থেকেই আসে SMV, যা Target, Cost ও Line Setup এর ভিত্তি।</p>
  </div>

  <nav class="toc" aria-label="এই Part এর সূচি">
    <strong>এই Part এ যা আছে</strong>
    <ol>
      <li><a href="#t1">Work Measurement কী ও কেন</a></li>
      <li><a href="#t2">Stopwatch Time Study এর ধাপ</a></li>
      <li><a href="#t3">Rating (গতি মূল্যায়ন)</a></li>
      <li><a href="#t4">Allowance (ছাড়)</a></li>
      <li><a href="#t5">Standard Time ও SMV হিসাব</a></li>
      <li><a href="#t6">পুরো Example: Handle Stitching</a></li>
      <li><a href="#t7">কয়টা Cycle মাপা দরকার</a></li>
      <li><a href="#t8">অন্য পদ্ধতি: PTS, Work Sampling</a></li>
      <li><a href="#t9">নিজে হিসাব করুন (Calculator)</a></li>
      <li><a href="#t10">সাধারণ ভুল</a></li>
      <li><a href="#t11">Practice Quiz</a></li>
    </ol>
  </nav>

  <!-- 1 -->
  <section class="topic" id="t1">
    <h2>1. Work Measurement কী ও কেন</h2>

    <h3>কী (Definition)</h3>
    <p><b class="term">Work Measurement</b> হলো একজন দক্ষ Operator, নির্ধারিত পদ্ধতিতে ও স্বাভাবিক গতিতে কাজ করলে একটা Operation এ কত সময় লাগে, তা মাপা। এই সময়কে বলে <b class="term">Standard Time</b> বা <b class="term">SMV</b>।</p>

    <h3>কেন</h3>
    <ul class="plain">
      <li>প্রতিদিনের <b class="term">Target</b> ও Order শেষ করার সময় ঠিক করতে।</li>
      <li>কয়জন Operator ও কোন Machine লাগবে হিসাব করতে।</li>
      <li><b class="term">Costing</b> এ CM (Cost of Making) বের করতে।</li>
      <li>Line Balancing ও Efficiency মাপতে।</li>
      <li>Incentive বা Bonus এর ন্যায্য ভিত্তি তৈরি করতে।</li>
    </ul>

    <div class="note ok"><strong>✅ মনে রাখো:</strong> Method আগে ঠিক করো (Part 2), তারপর সময় মাপো। খারাপ Method এর সময় মাপলে ভুল Standard তৈরি হয়।</div>

    <h3>প্রধান পদ্ধতিগুলো</h3>
    <ul class="plain">
      <li><b class="term">Stopwatch Time Study:</b> সরাসরি দাঁড়িয়ে সময় মাপা (এই Part এর মূল বিষয়)।</li>
      <li><b class="term">PTS (Predetermined Time Systems):</b> আগে থেকে ঠিক করা Movement এর সময় যোগ করে হিসাব, যেমন MTM, MOST।</li>
      <li><b class="term">Work Sampling:</b> নির্দিষ্ট সময় পরপর দেখে কতটা সময় কাজে ও কতটা অকাজে গেল তা বের করা।</li>
      <li><b class="term">Standard Data:</b> আগের মাপা Element এর সময় জমিয়ে রেখে নতুন Style এ ব্যবহার।</li>
    </ul>
  </section>

  <!-- 2 -->
  <section class="topic" id="t2">
    <h2>2. Stopwatch Time Study এর ধাপ</h2>

    <h3>কীভাবে</h3>
    <ol class="steps">
      <li><b>Operation বাছাই ও Method ঠিক আছে কিনা নিশ্চিত করা।</b> Method Study আগে হয়ে থাকতে হবে।</li>
      <li><b>Operator কে জানানো।</b> কেন মাপছি বুঝিয়ে বলা, একজন গড় দক্ষতার Operator বাছাই করা।</li>
      <li><b>Element এ ভাগ করা।</b> যেমন Handle ধরা, Stitch করা, Thread কাটা। আলাদা Element এর সময় আলাদা লেখা।</li>
      <li><b>Cycle Time লেখা।</b> একই কাজ কয়েকবার (সাধারণত ১০ বা তার বেশি) মেপে Sheet এ লেখা।</li>
      <li><b>Abnormal Cycle বাদ দেওয়া।</b> Thread ছিঁড়ে গেল বা Machine বিগড়ালে সেই Cycle ধরা যাবে না।</li>
      <li><b>Rating করা।</b> Operator স্বাভাবিকের চেয়ে দ্রুত না ধীর, তা শতকরায় লেখা।</li>
      <li><b>Allowance যোগ করে Standard Time বের করা।</b></li>
    </ol>

    <div class="note"><strong>💡 Tip:</strong> Stopwatch (বা ফোনের Stopwatch) ও Clipboard লাগবে। Element এর শেষে সময় থামিয়ে লিখুন, Operator কে বিরক্ত না করে একটু দূরে দাঁড়ান।</div>

    <h3>গুরুত্বপূর্ণ Term</h3>
    <div class="scroll">
    <table>
      <tr><th>Term</th><th>অর্থ</th></tr>
      <tr><td>Cycle Time</td><td>একটা Piece এর কাজ শুরু থেকে শেষ পর্যন্ত সময়</td></tr>
      <tr><td>Observed Time (OT)</td><td>Stopwatch এ মাপা গড় সময়</td></tr>
      <tr><td>Rating</td><td>Operator এর গতি স্বাভাবিকের তুলনায় শতকরা কত</td></tr>
      <tr><td>Basic Time (BT)</td><td>Rating দিয়ে সংশোধিত সময় (স্বাভাবিক গতির সময়)</td></tr>
      <tr><td>Allowance</td><td>প্রয়োজনীয় বিরতি ও বিলম্বের জন্য বাড়তি সময়</td></tr>
      <tr><td>Standard Time</td><td>Basic Time + Allowance</td></tr>
      <tr><td>SMV / SAM</td><td>Standard Time কে মিনিটে প্রকাশ (Standard Minute Value / Standard Allowed Minute)</td></tr>
    </table>
    </div>
  </section>

  <!-- 3 -->
  <section class="topic" id="t3">
    <h2>3. Rating (গতি মূল্যায়ন)</h2>

    <h3>কী ও কেন</h3>
    <p>Stopwatch এ যে সময় আসে, সেটা ওই Operator এর নিজের গতির সময়। সে হয়তো স্বাভাবিকের চেয়ে ধীর বা দ্রুত। তাই সবার জন্য <b class="term">একই মানের Standard</b> বানাতে Rating দিয়ে সময় সংশোধন করা হয়।</p>

    <h3>কীভাবে</h3>
    <p><b>স্বাভাবিক (Normal) গতি = ১০০%।</b> একজন প্রশিক্ষিত, সাধারণ প্রচেষ্টার Operator যে গতিতে ক্লান্ত না হয়ে সারাদিন কাজ করতে পারে।</p>
    <div class="scroll">
    <table>
      <tr><th>Rating</th><th>মানে</th></tr>
      <tr><td>80%</td><td>স্বাভাবিকের চেয়ে ধীর</td></tr>
      <tr><td>100%</td><td>স্বাভাবিক গতি</td></tr>
      <tr><td>120%</td><td>স্বাভাবিকের চেয়ে দ্রুত</td></tr>
    </table>
    </div>

    <div class="formula">
      Basic Time = Observed Time × (Rating ÷ 100)
      <small>Rating 100% এর বেশি হলে Basic Time বেশি হয়। কারণ দ্রুত Operator এর সময় "স্বাভাবিক" ধরতে বাড়াতে হয়।</small>
    </div>

    <div class="example">
      <strong>Example:</strong> Observed Time = 50 sec, Rating = 120%<br>
      Basic Time = 50 × 1.20 = <strong>60 sec</strong>
    </div>

    <div class="note warn"><strong>⚠️ সতর্কতা:</strong> Rating সবচেয়ে বেশি ভুল হয়। নিজের Judgement এর উপর নির্ভর না করে অভিজ্ঞ IE দের সাথে একসাথে Rating অনুশীলন করো। Video দেখে মিলিয়ে নিলে Bias কমে।</div>
  </section>

  <!-- 4 -->
  <section class="topic" id="t4">
    <h2>4. Allowance (ছাড়)</h2>

    <h3>কী ও কেন</h3>
    <p>Operator যন্ত্র নয়। প্রয়োজনীয় বিরতি ছাড়া সারাদিন কাজ করা সম্ভব নয়। তাই Basic Time এর সাথে কিছু বাড়তি সময় যোগ করা হয়, যাকে <b class="term">Allowance</b> বলে।</p>

    <div class="scroll">
    <table>
      <tr><th>ধরন</th><th>কিসের জন্য</th></tr>
      <tr><td>Personal</td><td>পানি খাওয়া, বাথরুম ইত্যাদি</td></tr>
      <tr><td>Fatigue (ক্লান্তি)</td><td>কাজের ধরন, দাঁড়ানো/বসা, ওজন, পরিবেশ অনুযায়ী</td></tr>
      <tr><td>Delay (অনিবার্য বিলম্ব)</td><td>Thread ছেঁড়া, Needle বদল, Material আনার অপেক্ষা</td></tr>
      <tr><td>Special / Policy</td><td>বিশেষ কাজ বা Company/Buyer এর নীতি অনুযায়ী</td></tr>
    </table>
    </div>

    <div class="note"><strong>💡 Tip:</strong> Allowance এর শতকরা মান Company ও Buyer এর নীতির উপর নির্ভর করে। এই সাইটের Example এ বোঝার জন্য মোট <b>15%</b> ধরা হয়েছে। নিজের Factory এর নিয়ম জেনে নাও।</div>
  </section>

  <!-- 5 -->
  <section class="topic" id="t5">
    <h2>5. Standard Time ও SMV হিসাব</h2>

    <h3>কীভাবে (সূত্রগুলো)</h3>
    <div class="formula">
      ১. Observed Time (OT) = মাপা সময়ের গড়<br>
      ২. Basic Time (BT) = OT × (Rating ÷ 100)<br>
      ৩. Standard Time = BT × (1 + Allowance ÷ 100)<br>
      ৪. SMV (মিনিটে) = Standard Time (সেকেন্ড) ÷ 60
      <small>এখানে Allowance কে Basic Time এর শতকরা ধরা হয়েছে।</small>
    </div>

    <div class="formula">
      Bag এর মোট SMV = সব Operation এর SMV এর যোগফল
    </div>

    <div class="note ok"><strong>✅ মনে রাখো:</strong> SMV মিনিটে প্রকাশ করা হয়। Stopwatch এর সেকেন্ডকে ৬০ দিয়ে ভাগ করতে ভুলো না।</div>
  </section>

  <!-- 6 -->
  <section class="topic" id="t6">
    <h2>6. পুরো Example: Handle Stitching</h2>
    <p>একটা Tote Bag এর Handle Stitching Operation (কাল্পনিক ডেটা)।</p>

    <h3>ধাপ ১: ১০টা Cycle Time (সেকেন্ডে)</h3>
    <div class="scroll">
    <table>
      <tr><th>Cycle</th><th>1</th><th>2</th><th>3</th><th>4</th><th>5</th><th>6</th><th>7</th><th>8</th><th>9</th><th>10</th></tr>
      <tr><td>সময় (sec)</td><td>42</td><td>45</td><td>40</td><td>44</td><td>43</td><td>41</td><td>46</td><td>44</td><td>42</td><td>43</td></tr>
    </table>
    </div>

    <h3>ধাপ ২: হিসাব</h3>
    <div class="example">
      যোগফল = 430 sec, গড় (OT) = 430 ÷ 10 = <strong>43.0 sec</strong><br>
      Rating = 90%, তাই BT = 43.0 × 0.90 = <strong>38.7 sec</strong><br>
      Allowance = 15%, তাই Standard Time = 38.7 × 1.15 = <strong>44.5 sec</strong><br>
      SMV = 44.5 ÷ 60 = <strong>0.74 মিনিট</strong>
    </div>

    <h3>ধাপ ৩: এর মানে কী?</h3>
    <p>একজন Operator ১০০% Efficiency তে এই Operation প্রতি ঘণ্টায় প্রায় <b class="term">৬০ ÷ ০.৭৪ ≈ ৮১টি</b> করতে পারবে। বাস্তবে Efficiency ১০০% হয় না, সেটা Part 5 ও 6 এ দেখবো।</p>

    <div class="formula">
      ঘণ্টায় Output (১০০% Efficiency তে) = ৬০ ÷ SMV
    </div>

    <div class="example">
      <strong>পুরো Bag:</strong> ধরো ২৮টা Operation এর SMV যোগ করে মোট SMV = <strong>18.5 মিনিট</strong> পাওয়া গেল। তাহলে একটা Bag বানাতে Standard ১৮.৫ মিনিটের শ্রম লাগে, আর এই সংখ্যা দিয়েই Cost ও Target হিসাব হবে।
    </div>
  </section>

  <!-- 7 -->
  <section class="topic" id="t7">
    <h2>7. কয়টা Cycle মাপা দরকার</h2>

    <h3>কী ও কেন</h3>
    <p>খুব কম Cycle মাপলে গড় ভুল হতে পারে। আবার বেশি মাপলে সময় নষ্ট। তাই পরিসংখ্যানের সূত্রে বের করা হয়।</p>

    <div class="formula">
      N = ( 40 × √( n×Σx² − (Σx)² ) ÷ Σx )²
      <small>(৯৫% আস্থা ও ±৫% নির্ভুলতার জন্য। n = প্রাথমিক Cycle সংখ্যা, x = প্রতিটা সময়।)</small>
    </div>

    <div class="example">
      <strong>উপরের Example এ:</strong> n = 10, Σx = 430, Σx² = 18,520<br>
      n×Σx² − (Σx)² = 185,200 − 184,900 = 300<br>
      √300 ≈ 17.32, তাই 40 × 17.32 ÷ 430 ≈ 1.61, তার বর্গ ≈ <strong>2.6</strong><br>
      অর্থাৎ প্রায় ৩টা Cycle যথেষ্ট। আমরা ১০টা নিয়েছি, তাই ডেটা নির্ভরযোগ্য।
    </div>

    <div class="note"><strong>💡 Tip:</strong> সময়গুলো যত বেশি ছড়ানো (কম-বেশি), তত বেশি Cycle লাগে। সাধারণত ছোট Cycle এ কমপক্ষে ১০টা মাপা ভালো অভ্যাস।</div>
  </section>

  <!-- 8 -->
  <section class="topic" id="t8">
    <h2>8. অন্য পদ্ধতি: PTS ও Work Sampling</h2>

    <h3>PTS (MTM, MOST)</h3>
    <p>প্রতিটা Movement (Reach, Grasp, Move ইত্যাদি) এর জন্য আগে থেকে ঠিক করা সময় আছে। কাজকে Movement এ ভেঙে সেই সময় যোগ করলেই Standard Time পাওয়া যায়, <b class="term">Stopwatch ছাড়াই</b>। MTM এ সময়ের একক <b class="term">TMU</b>, যেখানে 1 TMU = 0.00001 ঘণ্টা = 0.0006 মিনিট।</p>
    <p><b>সুবিধা:</b> Style আসার আগেই (Sample দেখেই) SMV অনুমান করা যায়। Rating এর ঝামেলা নেই।</p>

    <h3>Work Sampling</h3>
    <p>সারাদিনে এলোমেলো সময়ে Operator বা Machine দেখে লেখা হয়: কাজ করছে, না অপেক্ষা করছে। এতে বোঝা যায় <b class="term">কত শতাংশ সময় অপচয় হচ্ছে।</b></p>

    <div class="example">
      <strong>Example:</strong> ২০০ বার দেখে ৩০ বার Machine বন্ধ পেলে Idle = 30 ÷ 200 = 15%। এতে বোঝা যায় Machine Idle সময়ের কারণ খুঁজতে হবে।
    </div>
  </section>

  <!-- 9 Calculator -->
  <section class="topic" id="t9">
    <h2>9. নিজে হিসাব করুন (SMV Calculator)</h2>
    <p>Floor এ মাপা সময়গুলো লিখে নিজেই SMV বের করে ফেলো। সময় লেখো সেকেন্ডে, কমা বা Space দিয়ে আলাদা করে।</p>

    <div class="calc">
      <label for="times">Cycle Time (সেকেন্ডে)</label>
      <textarea id="times" rows="3" placeholder="যেমন: 42, 45, 40, 44, 43, 41, 46, 44, 42, 43"></textarea>
      <div class="row">
        <div>
          <label for="rating">Rating (%)</label>
          <input id="rating" type="number" inputmode="decimal" value="90">
        </div>
        <div>
          <label for="allow">Allowance (%)</label>
          <input id="allow" type="number" inputmode="decimal" value="15">
        </div>
      </div>
      <button type="button" id="go">হিসাব করো</button>
      <p class="err" id="err"></p>
      <div class="out" id="out">
        <table>
          <tr><th>বিষয়</th><th>ফল</th></tr>
          <tr><td>Cycle সংখ্যা</td><td id="r-n"></td></tr>
          <tr><td>Observed Time (গড়)</td><td id="r-ot"></td></tr>
          <tr><td>Basic Time</td><td id="r-bt"></td></tr>
          <tr><td>Standard Time</td><td id="r-st"></td></tr>
          <tr><td><b>SMV</b></td><td id="r-smv"></td></tr>
          <tr><td>ঘণ্টায় Output (১০০% Efficiency)</td><td id="r-out"></td></tr>
        </table>
      </div>
    </div>
  </section>

  <!-- 10 -->
  <section class="topic" id="t10">
    <h2>10. সাধারণ ভুল</h2>
    <div class="note warn"><strong>⚠️ ভুল ১:</strong> Method ঠিক না করেই সময় মাপা।<br><b>সঠিক:</b> আগে Method Study (Part 2), তারপর Time Study।</div>
    <div class="note warn"><strong>⚠️ ভুল ২:</strong> সবচেয়ে দ্রুত বা সবচেয়ে ধীর Operator কে মাপা।<br><b>সঠিক:</b> গড় দক্ষতার, প্রশিক্ষিত Operator বাছাই করো।</div>
    <div class="note warn"><strong>⚠️ ভুল ৩:</strong> Rating বাদ দিয়ে শুধু গড় সময়কে Standard ধরা।<br><b>সঠিক:</b> Rating দিয়ে স্বাভাবিক গতিতে আনতেই হবে।</div>
    <div class="note warn"><strong>⚠️ ভুল ৪:</strong> খুব কম Cycle মেপে সিদ্ধান্ত নেওয়া।<br><b>সঠিক:</b> কমপক্ষে ১০টা মাপো, ছড়ানো বেশি হলে আরও।</div>
    <div class="note warn"><strong>⚠️ ভুল ৫:</strong> Abnormal Cycle (Thread ছেঁড়া, Machine সমস্যা) গড়ে ধরা।<br><b>সঠিক:</b> ওগুলো বাদ দাও বা Delay হিসেবে আলাদা লেখো।</div>
    <div class="note warn"><strong>⚠️ ভুল ৬:</strong> একবার মাপা SMV বছরের পর বছর ব্যবহার করা।<br><b>সঠিক:</b> Method, Machine বা Material বদলালে SMV আবার মাপো।</div>
  </section>

  <!-- 11 Quiz -->
  <section class="topic" id="t11">
    <h2>11. Practice Quiz</h2>
    <p>প্রতিটা প্রশ্নের একটা উত্তর বেছে নাও। সঙ্গে সঙ্গে সঠিক উত্তর ও কারণ দেখতে পাবে।</p>
    <div id="quiz"></div>
    <div class="score" id="score"></div>
    <p style="margin-top:14px"><b>Home Task:</b> Floor এ একটা ছোট Operation এর ১০টা Cycle মাপো। উপরের Calculator এ বসিয়ে SMV বের করো। তারপর নিজের Factory এর আগের SMV এর সাথে মিলিয়ে দেখো।</p>
  </section>

  <div class="pager">
    <a class="prev" href="part-2.html">← Part 2: Method Study</a>
    <a class="next" href="part-4.html">Part 4: Operation Breakdown →</a>
  </div>

</div>
</main>

<footer>
  <div class="wrap">IE শিখি · Part 3: Time Study ও Work Measurement</div>
</footer>

<script>
  // ---- Calculator ----
  document.getElementById('go').addEventListener('click', function(){
    const err = document.getElementById('err');
    const out = document.getElementById('out');
    err.style.display = 'none';
    out.style.display = 'none';

    const nums = document.getElementById('times').value
      .split(/[\s,;]+/).map(Number).filter(n => !isNaN(n) && n > 0);
    const rating = parseFloat(document.getElementById('rating').value);
    const allow = parseFloat(document.getElementById('allow').value);

    if (nums.length < 3) { err.textContent = 'কমপক্ষে ৩টা সময় লিখুন (১০টা হলে ভালো)।'; err.style.display = 'block'; return; }
    if (isNaN(rating) || rating <= 0) { err.textContent = 'Rating সঠিকভাবে লিখুন, যেমন 90।'; err.style.display = 'block'; return; }
    if (isNaN(allow) || allow < 0) { err.textContent = 'Allowance সঠিকভাবে লিখুন, যেমন 15।'; err.style.display = 'block'; return; }

    const ot = nums.reduce((a,b) => a + b, 0) / nums.length;
    const bt = ot * rating / 100;
    const st = bt * (1 + allow / 100);
    const smv = st / 60;
    const perHour = 60 / smv;

    document.getElementById('r-n').textContent = nums.length + ' টি';
    document.getElementById('r-ot').textContent = ot.toFixed(2) + ' sec';
    document.getElementById('r-bt').textContent = bt.toFixed(2) + ' sec';
    document.getElementById('r-st').textContent = st.toFixed(2) + ' sec';
    document.getElementById('r-smv').textContent = smv.toFixed(3) + ' মিনিট';
    document.getElementById('r-out').textContent = perHour.toFixed(1) + ' Pcs';
    out.style.display = 'block';
  });

  // ---- Quiz ----
  const quiz = [
    {q:"স্বাভাবিক (Normal) গতির Rating কত ধরা হয়?",
     o:["80%","100%","120%"],
     a:1, w:"স্বাভাবিক গতি = ১০০%। এর কম মানে ধীর, বেশি মানে দ্রুত।"},
    {q:"Observed Time 50 sec, Rating 120% হলে Basic Time কত?",
     o:["41.7 sec","50 sec","60 sec"],
     a:2, w:"Basic Time = Observed Time × Rating ÷ 100 = 50 × 1.20 = 60 sec।"},
    {q:"Basic Time 40 sec ও Allowance 10% হলে Standard Time কত?",
     o:["44 sec","36 sec","50 sec"],
     a:0, w:"Standard Time = 40 × (1 + 0.10) = 44 sec।"},
    {q:"SMV 0.5 মিনিট হলে ১০০% Efficiency তে ঘণ্টায় Output কত?",
     o:["60 Pcs","120 Pcs","30 Pcs"],
     a:1, w:"ঘণ্টায় Output = ৬০ ÷ SMV = ৬০ ÷ ০.৫ = ১২০ Pcs।"},
    {q:"Time Study এর আগে কোনটা ঠিক করে নেওয়া উচিত?",
     o:["Incentive এর হার","Method (কাজের পদ্ধতি)","Machine এর রঙ"],
     a:1, w:"আগে Method Study করে সেরা পদ্ধতি ঠিক করতে হয়। খারাপ Method এর সময় মাপলে ভুল Standard তৈরি হয়।"}
  ];

  const box = document.getElementById('quiz');
  const scoreEl = document.getElementById('score');
  let answered = 0, correct = 0;

  quiz.forEach((item, i) => {
    const d = document.createElement('div');
    d.className = 'q';
    d.innerHTML = `<p class="qt">${i+1}. ${item.q}</p>`;
    const why = document.createElement('p');
    why.className = 'why';
    const btns = item.o.map((txt, j) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = txt;
      b.addEventListener('click', () => {
        if (d.dataset.done) return;
        d.dataset.done = '1';
        answered++;
        if (j === item.a) { b.classList.add('right'); correct++; why.textContent = '✅ সঠিক! ' + item.w; }
        else { b.classList.add('wrong'); btns[item.a].classList.add('right'); why.textContent = '⚠️ ভুল। ' + item.w; }
        why.style.display = 'block';
        if (answered === quiz.length) {
          scoreEl.textContent = `তোমার স্কোর: ${correct} / ${quiz.length}` + (correct === quiz.length ? ' 🎉 দারুণ!' : ' — আবার পড়ে চেষ্টা করো।');
        }
      });
      d.appendChild(b);
      return b;
    });
    d.appendChild(why);
    box.appendChild(d);
  });
</script>
</body>
</html>

<style>
#scrollUpBtn,#scrollDownBtn{position:fixed;right:18px;width:46px;height:46px;border-radius:50%;background:#7A1F2B;color:#FFF;border:none;font-size:22px;cursor:pointer;box-shadow:0 3px 10px rgba(0,0,0,0.25);display:none;z-index:999;align-items:center;justify-content:center;transition:opacity 0.3s}
#scrollUpBtn{bottom:80px}
#scrollDownBtn{bottom:20px}
#scrollUpBtn:hover,#scrollDownBtn:hover{background:#5E1721}
#scrollUpBtn.show,#scrollDownBtn.show{display:flex}
@media(max-width:480px){#scrollUpBtn,#scrollDownBtn{width:42px;height:42px;font-size:20px;right:14px}}
</style>
<button id="scrollUpBtn" aria-label="উপরে যাও" title="উপরে যাও">↑</button>
<button id="scrollDownBtn" aria-label="নিচে যাও" title="নিচে যাও">↓</button>
<script>
(function(){
var upBtn=document.getElementById("scrollUpBtn");
var downBtn=document.getElementById("scrollDownBtn");
function updateButtons(){
var s=window.scrollY;
var t=document.documentElement.scrollHeight;
var w=window.innerHeight;
if(s>300){upBtn.classList.add("show")}else{upBtn.classList.remove("show")}
if(s+w<t-400){downBtn.classList.add("show")}else{downBtn.classList.remove("show")}
}
upBtn.addEventListener("click",function(){window.scrollTo({top:0,behavior:"smooth"})});
downBtn.addEventListener("click",function(){window.scrollTo({top:document.documentElement.scrollHeight,behavior:"smooth"})});
window.addEventListener("scroll",updateButtons);
window.addEventListener("resize",updateButtons);
updateButtons();
})();
</script>

