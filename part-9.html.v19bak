<style>
  :root{
    --paper:#F3F5F7;--ink:#14213D;--ink-soft:#4A5670;--oxblood:#7A1F2B;--thread:#E9B824;
    --line:#D5DAE2;--white:#FFFFFF;--green:#2E7D5B;
    --head:'Anek Bangla','Hind Siliguri','Noto Sans Bengali',sans-serif;
